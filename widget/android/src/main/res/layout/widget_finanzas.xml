<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_tabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_tab_saldo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Saldo"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wallet" />

        <ImageButton
            android:id="@+id/widget_tab_bills"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Próximos pagos"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_calendar" />

        <ImageButton
            android:id="@+id/widget_tab_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Ingreso"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_down" />

        <ImageButton
            android:id="@+id/widget_tab_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Gasto"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_up" />

        <ImageButton
            android:id="@+id/widget_tab_transfer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Transferencia"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_swap" />
    </LinearLayout>

    <!-- Contenido desplazable: ListView alimentada por FinanzasWidgetService.
         La fila de pestanas queda fija arriba y esta lista se desliza
         arriba/abajo (un ScrollView no desplaza dentro de un widget). -->
    <ListView
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />
</LinearLayout>
