<?xml version="1.0" encoding="utf-8"?>
<!-- Atajos de la pestana: maximo 2 chips por fila para que el texto se lea
     completo sin cortarse. La segunda fila solo existe cuando hay un tercer
     chip (o "+ Nuevo" / "+N mas"): si chip_c esta GONE, la fila colapsa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#14211F"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chip_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#14211F"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_c"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#14211F"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
